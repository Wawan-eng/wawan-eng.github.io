            openProductModal(prodId);
        }

        // License Key Mass Upload Handler
        function handleBulkLicenseUpload(e) {
            e.preventDefault();
            const prodId = document.getElementById('license-product-select').value;
            const raw = document.getElementById('license-bulk-input').value.trim();

            if (!prodId || !raw) {
                showToast('Pilih produk dan masukkan minimal 1 kode lisensi!', 'error');
                return;
            }

            const lines = raw.split('\n').map(l => l.trim()).filter(l => l.length > 0);
            lines.forEach(key => {
                appState.licenses.push({
                    id: `lic-${Date.now()}-${Math.floor(Math.random()*1000)}`,
                    productId: prodId,
                    key: key,
                    status: 'available'
                });
            });

            saveToStorage();
            document.getElementById('license-bulk-input').value = '';
            renderAdminLicensesTable();
            showToast(`${lines.length} serial key lisensi berhasil disimpan ke stok!`, 'success');
        }

