        function simulateDownloadFile(orderId) {
            const order = appState.orders.find(o => o.id === orderId);
            if (order) {
                if (order.downloadsRemaining <= 0) {
                    showToast('Batas maksimal 3 kali unduhan telah tercapai!', 'error');
                    return;
                }
                order.downloadsRemaining -= 1;
                saveToStorage();
                showToast(`Memulai pengunduhan berkas aman... (Sisa kuota unduh: ${order.downloadsRemaining}/3)`, 'success');
            }
        }

        // Copy Helper
        function copyToClipboard(text) {
            const temp = document.createElement('textarea');
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            showToast('Teks berhasil disalin ke clipboard!', 'success');
