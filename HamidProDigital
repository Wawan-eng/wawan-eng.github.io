        function exportOrdersToCSV() {
            let csv = "ID,Email,WhatsApp,Produk,Total,Metode,Status,Tanggal\n";
            appState.orders.forEach(o => {
                csv += `"${o.id}","${o.customerEmail}","${o.customerPhone}","${o.productTitle}","${o.amount}","${o.paymentMethod}","${o.status}","${o.createdAt}"\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('href', url);
            a.setAttribute('download', `sales_report_hamid_prodigital_${Date.now()}.csv`);
            a.click();
            showToast('Laporan penjualan diekspor ke CSV!', 'success');
        }

        // Coupon Management
