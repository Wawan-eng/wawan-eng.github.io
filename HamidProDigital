                container.innerHTML = `<p class="text-xs text-slate-500 py-4 text-center">Keranjang belanja Anda kosong.</p>`;
                document.getElementById('checkout-subtotal').innerText = 'Rp 0';
                document.getElementById('checkout-total').innerText = 'Rp 0';
                return;
            }

            let subtotal = 0;
            appState.cart.forEach((item, index) => {
                subtotal += item.price;
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between p-3 bg-slate-950 rounded-xl border border-slate-800';
