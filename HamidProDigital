            appState.licenses.forEach(l => {
                const prod = appState.products.find(p => p.id === l.productId);
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3 font-sans text-white font-semibold">${prod ? prod.title : 'Produk Dihapus'}</td>
                    <td class="p-3 text-amber-300 font-bold">${l.key}</td>
