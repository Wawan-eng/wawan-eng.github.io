                `;
                container.appendChild(row);
            });

            calculateTotals(subtotal);
        }

        function removeFromCart(index) {
            appState.cart.splice(index, 1);
            updateCartUI();
        }

        function applyCheckoutCoupon() {
            const code = document.getElementById('checkout-coupon-code').value.trim().toUpperCase();
            const msg = document.getElementById('coupon-message');
            
            if (!code) return;

            const coupon = appState.coupons.find(c => c.code === code);
            if (!coupon) {
                msg.className = 'text-[11px] mt-1 text-rose-400 block';
                msg.innerText = 'Kode kupon tidak valid!';
                appState.appliedCoupon = null;
            } else if (coupon.used >= coupon.quota) {
                msg.className = 'text-[11px] mt-1 text-rose-400 block';
                msg.innerText = 'Kuota kupon telah habis!';
                appState.appliedCoupon = null;
            } else {
                appState.appliedCoupon = coupon;
                msg.className = 'text-[11px] mt-1 text-emerald-400 block';
                msg.innerText = `Kupon ${coupon.code} berhasil dipasang!`;
                showToast(`Kupon ${coupon.code} digunakan!`, 'success');
            }
            updateCartUI();
        }

        function calculateTotals(subtotal) {
            let discount = 0;
            if (appState.appliedCoupon) {
                if (appState.appliedCoupon.type === 'percent') {
                    discount = (subtotal * appState.appliedCoupon.value) / 100;
                } else {
                    discount = appState.appliedCoupon.value;
                }
            }

            const total = Math.max(0, subtotal - discount);

            document.getElementById('checkout-subtotal').innerText = formatRupiah(subtotal);
            if (discount > 0) {
                document.getElementById('checkout-discount-row').classList.remove('hidden');
                document.getElementById('checkout-discount').innerText = `-${formatRupiah(discount)}`;
            } else {
                document.getElementById('checkout-discount-row').classList.add('hidden');
            }
            document.getElementById('checkout-total').innerText = formatRupiah(total);
        }

        function processCheckoutFastTrack() {
            const email = document.getElementById('checkout-email').value.trim();
            const phone = document.getElementById('checkout-phone').value.trim();

            if (!email || !email.includes('@')) {
                showToast('Harap masukkan alamat email yang valid!', 'error');
                return;
            }
            if (!phone) {
                showToast('Harap masukkan nomor WhatsApp aktif!', 'error');
                return;
            }
            if (appState.cart.length === 0) {
                showToast('Keranjang belanja masih kosong!', 'error');
                return;
            }

            const pMethod = document.querySelector('input[name="payment_method"]:checked').value;
            const item = appState.cart[0]; // Fast-track main item

            // Calculate Final Price
            let subtotal = item.price;
            let discount = 0;
            if (appState.appliedCoupon) {
                discount = appState.appliedCoupon.type === 'percent' ? (subtotal * appState.appliedCoupon.value) / 100 : appState.appliedCoupon.value;
                // Increment Coupon Usage
                appState.appliedCoupon.used += 1;
            }
            const finalTotal = Math.max(0, subtotal - discount);

            // Assign License Key if product requires it
            let assignedKey = null;
            if (productRequiresLicense(item.id)) {
                const availableLic = appState.licenses.find(l => l.productId === item.id && l.status === 'available');
                if (availableLic) {
                    availableLic.status = 'redeemed';
                    availableLic.redeemedBy = email;
                    assignedKey = availableLic.key;
                } else {
                    assignedKey = `HAMID-GENERIC-KEY-${Math.floor(100000 + Math.random() * 900000)}`;
                }
            }

            // Create New Order
            const newOrder = {
                id: `ORD-${Math.floor(10000 + Math.random() * 90000)}`,
                customerEmail: email,
                customerPhone: phone,
                productId: item.id,
                productTitle: item.title,
                amount: finalTotal,
                paymentMethod: pMethod,
                status: 'Paid', // Automatic instant verification simulation
                licenseKeyAssigned: assignedKey,
                createdAt: new Date().toISOString(),
                downloadToken: `token_${Math.random().toString(36).substring(2, 15)}_${Date.now()}`,
                downloadsRemaining: 3
            };

            appState.orders.unshift(newOrder);
            saveToStorage();

            // Clear Cart & Coupon
            appState.cart = [];
            appState.appliedCoupon = null;
            document.getElementById('checkout-coupon-code').value = '';
            document.getElementById('coupon-message').classList.add('hidden');
            updateCartUI();
            toggleCartDrawer(false);

            // Open Success & Deliverables Screen
            showSuccessDeliverablesModal(newOrder);
        }

