        function handleSaveProduct(e) {
            e.preventDefault();
            const prodId = document.getElementById('admin-prod-id').value;
            const title = document.getElementById('admin-prod-title').value;
            const category = document.getElementById('admin-prod-category').value;
            const price = parseFloat(document.getElementById('admin-prod-price').value);
            const desc = document.getElementById('admin-prod-desc').value;
            const fileUrl = document.getElementById('admin-prod-fileurl').value;
            const image = document.getElementById('admin-prod-image').value || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=500&q=80';
            const isBestseller = document.getElementById('admin-prod-bestseller').checked;
            const requiresLicense = document.getElementById('admin-prod-license').checked;

            if (prodId) {
                const p = appState.products.find(x => x.id === prodId);
                p.title = title; p.category = category; p.price = price;
                p.description = desc; p.fileUrl = fileUrl; p.image = image;
                p.isBestseller = isBestseller; p.requiresLicense = requiresLicense;
                showToast('Produk digital berhasil diperbarui!', 'success');
            } else {
                const newP = {
                    id: `prod-${Date.now()}`,
                    title, category, price,
                    rating: 5.0, reviewsCount: 1,
                    isBestseller, requiresLicense,
                    image, description: desc, fileUrl,
                    previewMedia: '<p class="text-slate-300">Sampel produk digital siap diakses.</p>'
                };
                appState.products.unshift(newP);
                showToast('Produk digital baru berhasil ditambahkan!', 'success');
